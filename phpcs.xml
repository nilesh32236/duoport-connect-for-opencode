<?xml version="1.0"?>
<ruleset name="OpenCode Connector">
	<rule ref="WordPress"/>
	<file>.</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>
	<!-- CI helper scripts are plain CLI PHP (no WP context); WP sniffs don't apply. -->
	<exclude-pattern>.github/*</exclude-pattern>
	<!-- tests/ are not shipped (see .distignore) and use PHPUnit/Mockery idioms
	     that fight WP sniffs; product code stays fully linted. -->
	<exclude-pattern>tests/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<config name="testVersion" value="8.2-"/>
	<!-- Allow PSR-4 file naming for namespaced src/ and tests/ -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>src/*</exclude-pattern>
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<!-- Allow camelCase for modern namespaced code — WordPress security/i18n still enforced -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName">
		<exclude-pattern>src/*</exclude-pattern>
	</rule>
</ruleset>
